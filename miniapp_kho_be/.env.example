# Cổng và địa chỉ lắng nghe. 0.0.0.0 để điện thoại cùng Wi-Fi gọi được.
PORT=4100
HOST=0.0.0.0

# Backend của portal dùng để kiểm tra token Super App (GET /api/auth/me).
# Mặc định là bản deploy. Chạy portal local (STORE=memory) thì đổi thành http://127.0.0.1:3000
PORTAL_API=https://miniapp-portal-be.onrender.com

# Thư mục dữ liệu sinh bởi `pnpm gen:data` và file nhật ký thay đổi.
DATA_DIR=./data
