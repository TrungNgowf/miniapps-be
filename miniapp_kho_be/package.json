{
  "name": "miniapp-kho-be",
  "version": "1.0.0",
  "private": true,
  "description": "API cho mini-app Kho hàng Minh Phát. Xác thực bằng token của Super App qua miniapp_portal_be.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:data": "tsx scripts/generate-data.ts",
    "gen:images": "tsx scripts/generate-images.ts",
    "gen": "pnpm gen:data && pnpm gen:images",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "accept": "tsx scripts/acceptance.ts",
    "test": "node --import tsx --test src/access.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
